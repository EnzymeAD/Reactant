# - Config file for the Reactant package

get_property(languages GLOBAL PROPERTY ENABLED_LANGUAGES)

if(REACTANT_WARN_COMPILER)
    if("C" IN_LIST languages)
        if ("${CMAKE_C_COMPILER_ID}" STREQUAL "GNU")
            message("project languages: ${languages}")
            message(WARNING "C compiler ID equals ${CMAKE_C_COMPILER_ID}\n"
            "C compiler: ${CMAKE_C_COMPILER}\n"
            "Using Reactant without an LLVM based C compiler.")
        endif()
    endif()

    if("CXX" IN_LIST languages)
        if ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "GNU")
            message("project languages: ${languages}")
            message(WARNING "C++ compiler equals ${CMAKE_CXX_COMPILER_ID}\n"
            "C++ compiler: ${CMAKE_CXX_COMPILER}\n"
            "Using Reactant without an LLVM based C++ compiler.")
        endif()
    endif()
endif()

# Compute paths
get_filename_component(Reactant_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
set(Reactant_LLVM_VERSION_MAJOR "@CONF_LLVM_VERSION_MAJOR@")
set(Reactant_LLVM_VERSION_MINOR "@CONF_LLVM_VERSION_MINOR@")
set(Reactant_LLVM_VERSION_PATCH "@CONF_LLVM_VERSION_PATCH@")
set(Reactant_LLVM_DIR "@CONF_LLVM_DIR@")
set(Reactant_LLVM_BINARY_DIR "@CONF_LLVM_BINARY_DIR@")
set(Reactant_CLANG_EXE "@CONF_CLANG_EXE@")

# Our library dependencies (contains definitions for IMPORTED targets)
if(NOT TARGET ClangReactantFlags
   AND NOT TARGET ClangReactant-${Reactant_LLVM_VERSION_MAJOR} AND NOT Reactant_BINARY_DIR)
  include("${Reactant_CMAKE_DIR}/ReactantTargets.cmake")
  # These are IMPORTED targets created by ReactantTargets.cmake
  set(Reactant_LIBRARIES ClangReactantFlags 
      ClangReactant-${Reactant_LLVM_VERSION_MAJOR})
endif()
